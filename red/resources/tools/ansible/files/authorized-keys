#!/usr/local/bin/bb

;; Merge this generation's deploy keys into the deploy user's authorized_keys,
;; keeping the previous generation alongside the current one.
;;
;; Deploy keys are ephemeral: ONCE generates them on every create and does not
;; remember what it issued. Installing a new key therefore invalidates the old
;; one the moment this runs, and if the subsequent publication to GitHub fails,
;; the repository is left holding a key the box no longer accepts. Retaining
;; one previous generation per host closes that window — the old key keeps
;; working until the new one has been published, and the next create prunes it.
;;
;; Two generations is the whole benefit. Anything more only extends how long a
;; leaked key stays usable.
;;
;; Ordering comes from position in the file, not from a timestamp: this content
;; is rendered into an artifact the three colours compare byte for byte, and a
;; clock reading in a key comment would make that comparison fail.

(require '[clojure.java.io :as io]
         '[clojure.string :as str])

;; No trailing space: an entry written before deploy keys carried their own host
;; reads `command="/usr/local/bin/deploy"`, and it has to be recognised as ours
;; so that it is pruned. Left unmatched it would be mistaken for a foreign key
;; and preserved forever — inert, because the current script refuses to run
;; without a permitted host, but still sitting in the file.
(def managed-marker "command=\"/usr/local/bin/deploy")

(defn managed? [line]
  (str/includes? line managed-marker))

(defn host-of [line]
  (second (re-find #"command=\"/usr/local/bin/deploy ([^\"]+)\"" line)))

(defn read-lines [path]
  (let [f (io/file path)]
    (if (.exists f)
      (->> (slurp f) str/split-lines (remove str/blank?) vec)
      [])))

(defn reconcile
  "Foreign lines pass through untouched. For every host in `current`, keep the
  most recent previously installed key — the last matching line, since new keys
  are appended — followed by the new one. Hosts that left desired state, and
  generations older than one, are dropped."
  [current existing]
  (let [foreign (vec (remove managed? existing))
        managed (filter managed? existing)]
    (into foreign
          (mapcat (fn [line]
                    (let [host (host-of line)
                          previous (->> managed
                                        (filter #(= host (host-of %)))
                                        (remove #(= % line))
                                        last)]
                      (if previous [previous line] [line])))
                  current))))

(defn -main [& args]
  (let [[staged target] args]
    (when (or (str/blank? (str staged)) (str/blank? (str target)))
      (binding [*out* *err*]
        (println "once-authorized-keys: usage: once-authorized-keys STAGED TARGET"))
      (System/exit 1))
    (let [result (reconcile (read-lines staged) (read-lines target))
          content (if (seq result) (str (str/join "\n" result) "\n") "")
          before (let [f (io/file target)] (when (.exists f) (slurp f)))]
      (if (= content before)
        (println "unchanged")
        (do (io/make-parents target)
            (spit target content)
            (println "changed"))))))

(when (= *file* (System/getProperty "babashka.file"))
  (apply -main *command-line-args*))
