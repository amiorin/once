{:deps {io.github.amiorin/once {:local/root "."}}
 :tasks
 {:requires ([io.github.amiorin.once.params :as params]
             [io.github.amiorin.once.options :refer [oci] :rename {oci options}]
             [io.github.amiorin.once.package :as package]
             [io.github.amiorin.once.tools :as tools])
  help {:doc "the workflow help"
        :override-builtin true
        :task (println "Usage: bb <step|cmd>+ -- [raw-command]

See:
* https://bigconfig.it/paramss/intro/
* https://bigconfig.it/api/workflow/")}
  tidy {:doc "tidy clojure files"
        :task (do (shell "clojure-lsp clean-ns")
                  (shell "clojure-lsp format"))}
  tofu {:doc "bb tofu render tofu:init lock tofu:apply:-auto-approve"
        :task (tools/tofu* *command-line-args* (params/once-opts options))}
  tofu-dns {:doc "bb tofu-dns render tofu:init lock tofu:apply:-auto-approve"
            :task (tools/tofu-dns* *command-line-args* (params/once-opts options))}
  tofu-smtp {:doc "bb tofu-smtp render tofu:init lock tofu:apply:-auto-approve"
             :task (tools/tofu-smtp* *command-line-args* (params/once-opts options))}
  tofu-smtp-post {:doc "bb tofu-smtp-post render tofu:init lock tofu:apply:-auto-approve"
                  :task (tools/tofu-smtp-post* *command-line-args* (params/once-opts options))}
  ansible {:doc "bb ansible render -- ansible-playbook main.yml"
           :task (tools/ansible* *command-line-args* (params/once-opts options))}
  ansible-local {:doc "bb ansible render -- ansible-playbook main.yml"
                 :task (tools/ansible-local* *command-line-args* (params/once-opts options))}
  once {:doc "bb once create"
        :task (package/once* *command-line-args* options)}}}
