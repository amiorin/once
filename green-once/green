#!/usr/bin/env bb
;; Self-contained Green launcher for a production, single-server ONCE stack.
;; Configuration lives in ./green.edn. Secrets are read from environment
;; variables and are never expected in the desired-state file.

(require '[babashka.fs :as fs])

(def script-dir
  (let [file (if (= "NO_SOURCE_PATH" *file*)
               (fs/path (fs/cwd) "green")
               (fs/path *file*))]
    (str (fs/parent (fs/canonicalize file)))))

;; Green is not published to Clojars yet, so external copies of this launcher
;; use an immutable git dependency. GREEN_LIB_ROOT is only a development/test
;; override for working on Green itself.
(when (System/getProperty "babashka.version")
  (let [green-dep (if-let [root (System/getenv "GREEN_LIB_ROOT")]
                    {:local/root root}
                    {:git/url "https://github.com/amiorin/green.git"
                     :git/sha "1b31169dcb69513402aedc8c10b04b509929fa4c"})]
    ((requiring-resolve 'babashka.deps/add-deps)
     {:deps {'io.github.amiorin/green green-dep}})))

(require '[babashka.cli :as bb-cli]
         '[cheshire.core :as json]
         '[clojure.edn :as edn]
         '[clojure.java.io :as io]
         '[clojure.java.shell :as sh]
         '[clojure.string :as str]
         '[clojure.walk :as walk]
         '[green.ansible :as ansible]
         '[green.cli :as green-cli]
         '[green.dry-run :as dry-run]
         '[green.progress :as progress]
         '[green.tofu :as tofu]
         '[green.workflow :as wf])

;; ---------------------------------------------------------------------------
;; Desired state and validation

(defn- placeholder?
  [x]
  (or (nil? x)
      (and (string? x)
           (or (str/blank? x)
               (= "REPLACE_ME" (str/upper-case x))))))

(defn- parse-override
  [old value]
  (cond
    (boolean? old) (case (str/lower-case value)
                     "true" true
                     "false" false
                     value)
    (integer? old) (or (parse-long value) value)
    :else value))

(defn read-green-pars
  "Overlay GREEN_PAR_* variables onto matching flat keys in opts. Secrets use
  their provider-native environment names instead; this facility is intended
  for non-secret deployment overrides."
  ([opts] (read-green-pars opts (System/getenv)))
  ([opts env]
   (reduce-kv
    (fn [result k value]
      (let [env-name (str k)]
        (if (and (str/starts-with? env-name "GREEN_PAR_")
                 (< (count "GREEN_PAR_") (count env-name)))
          (let [key (-> env-name
                        (subs (count "GREEN_PAR_"))
                        str/lower-case
                        (str/replace "_" "-")
                        keyword)]
            (assoc result key (parse-override (get result key) value)))
          result)))
    opts
    env)))

(defn tool-dir
  "Return the isolated working directory for a tool in the active profile."
  [opts tool]
  (str (io/file (or (:workdir opts) ".green")
                (or (:profile opts) "default")
                tool)))

(defn- state-output
  [opts tool]
  (try
    (some-> (tofu/outputs (tool-dir opts tool)) :params walk/keywordize-keys)
    (catch Exception _ nil)))

(def ^:private compute-providers
  #{"digitalocean" "hcloud" "oci" "no-infra"})
(def ^:private smtp-providers #{"resend" "no-infra"})
(def ^:private dns-providers #{"cloudflare" "no-infra"})
(def ^:private backend-providers #{"local" "s3" "r2"})

(def ^:private provider-required-keys
  {"digitalocean" [:digitalocean-name :digitalocean-region
                    :digitalocean-size :digitalocean-image]
   "hcloud" [:hcloud-name :hcloud-image :hcloud-server-type :hcloud-location]
   "oci" [:oci-region :oci-subnet-id :oci-compartment-id
           :oci-availability-domain :oci-display-name :oci-shape
           :oci-ocpus :oci-memory-in-gbs :oci-boot-volume-size-in-gbs
           :oci-boot-volume-vpus-per-gb]
   "no-infra-compute" [:no-infra-compute-ip :no-infra-compute-user
                        :no-infra-compute-sudoer :no-infra-compute-uid]
   "resend" [:resend-server :resend-port :resend-username]
   "no-infra-smtp" [:no-infra-smtp-server :no-infra-smtp-port
                     :no-infra-smtp-username]
   "s3" [:s3-bucket :s3-region]
   "r2" [:r2-bucket :r2-endpoint]})

(def ^:private domain-re
  #"^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$")
(def ^:private env-name-re #"^[A-Z_][A-Z0-9_]*$")

(defn- required-errors
  [opts keys]
  (keep (fn [k]
          (when (placeholder? (get opts k))
            (str k " is required")))
        keys))

(defn- app-errors
  [domain applications]
  (mapcat
   (fn [[idx app]]
     (let [host (:host app)
           env (:env app)]
       (concat
        (when (or (placeholder? host) (not (re-matches domain-re (str host))))
          [(format ":once :applications[%d] has an invalid :host" idx)])
        (when (and (string? host)
                   (string? domain)
                   (not (or (= host domain)
                            (str/ends-with? host (str "." domain)))))
          [(format ":once :applications[%d] host must belong to %s" idx domain)])
        (when (placeholder? (:image app))
          [(format ":once :applications[%d] requires :image" idx)])
        (when-not (or (nil? env) (map? env))
          [(format ":once :applications[%d] :env must map container names to environment-variable names" idx)])
        (when (map? env)
          (mapcat (fn [[container-name env-name]]
                    (concat
                     (when-not (re-matches env-name-re (str container-name))
                       [(format "invalid container environment name %s" container-name)])
                     (when-not (re-matches env-name-re (str env-name))
                       [(format "invalid host environment name %s" env-name)])))
                  env)))))
   (map-indexed vector applications)))

(defn- desired-state-errors
  [opts]
  (let [compute (:provider-compute opts)
        smtp (:provider-smtp opts)
        dns (:provider-dns opts)
        backend (:provider-backend opts)
        applications (get-in opts [:once :applications])
        required (concat
                  [:profile :workdir :domain :package :deploy-pubkey]
                  (when (not= compute "no-infra") [:compute-pubkey])
                  (get provider-required-keys
                       (if (= compute "no-infra") "no-infra-compute" compute))
                  (get provider-required-keys
                       (if (= smtp "no-infra") "no-infra-smtp" smtp))
                  (get provider-required-keys backend))]
    (vec
     (concat
      (required-errors opts required)
      (when-not (contains? compute-providers compute)
        [(str "unsupported :provider-compute " (pr-str compute))])
      (when-not (contains? smtp-providers smtp)
        [(str "unsupported :provider-smtp " (pr-str smtp))])
      (when-not (contains? dns-providers dns)
        [(str "unsupported :provider-dns " (pr-str dns))])
      (when-not (contains? backend-providers backend)
        [(str "unsupported :provider-backend " (pr-str backend))])
      (when-not (and (string? (:domain opts))
                     (re-matches domain-re (:domain opts)))
        [":domain must be a fully-qualified lowercase domain"])
      (when-not (and (vector? applications) (seq applications))
        [":once :applications must be a non-empty vector"])
      (when (vector? applications)
        (app-errors (:domain opts) applications))
      (when-not (boolean? (:compute-prevent-destroy opts))
        [":compute-prevent-destroy must be true or false"])
      (when (and (not= compute "no-infra")
                 (not (str/starts-with? (str (:compute-pubkey opts)) "ssh-")))
        [":compute-pubkey must be an SSH public key"])
      (when-not (str/starts-with? (str (:deploy-pubkey opts)) "ssh-")
        [":deploy-pubkey must be an SSH public key"])))))

(defn- provider-secret-env
  [opts event]
  (let [create? (= :create event)]
    (vec
     (concat
      (case (:provider-compute opts)
        "digitalocean" ["DIGITALOCEAN_TOKEN"]
        "hcloud" ["HCLOUD_TOKEN"]
        "oci" ["TF_VAR_oci_tenancy_ocid" "TF_VAR_oci_user_ocid"
               "TF_VAR_oci_fingerprint" "TF_VAR_oci_private_key"]
        [])
      (case (:provider-smtp opts)
        "resend" (cond-> ["TF_VAR_resend_api_key"]
                   create? (conj "ONCE_SMTP_PASSWORD"))
        "no-infra" (if create? ["ONCE_SMTP_PASSWORD"] [])
        [])
      (when (= "cloudflare" (:provider-dns opts))
        ["CLOUDFLARE_API_TOKEN"])
      (when (contains? #{"s3" "r2"} (:provider-backend opts))
        ["AWS_ACCESS_KEY_ID" "AWS_SECRET_ACCESS_KEY"])
      (when create?
        (mapcat (fn [app]
                  (if (map? (:env app)) (vals (:env app)) []))
                (get-in opts [:once :applications])))))))

(defn- missing-secret-env
  [opts event]
  (->> (provider-secret-env opts event)
       distinct
       (filter #(placeholder? (System/getenv %)))
       vec))

(defn start-step
  [opts]
  (let [opts (read-green-pars (merge {:compute-prevent-destroy true} opts))
        event (:green/event opts)
        state-errors (desired-state-errors opts)
        secret-errors (when (and (not (:green/dry-run opts))
                                 (#{:create :delete} event))
                        (map #(str "required environment variable is not set: " %)
                             (missing-secret-env opts event)))
        delete-errors (when (and (= :delete event)
                                 (not (:green/dry-run opts))
                                 (:compute-prevent-destroy opts))
                        ["compute destruction is protected; set GREEN_PAR_COMPUTE_PREVENT_DESTROY=false to delete"])
        errors (vec (concat state-errors secret-errors delete-errors))
        opts (if (and (= :delete event)
                      (not (:green/dry-run opts))
                      (empty? errors))
               (let [compute (state-output opts "tofu-compute")
                     smtp (state-output opts "tofu-smtp")]
                 (cond-> opts
                   compute (merge compute)
                   compute (assoc :once/compute-params compute
                                  :once/existing-compute? true)
                   smtp (merge smtp)
                   smtp (assoc :once/smtp-params smtp
                               :once/existing-smtp? true)))
               opts)]
    (if (seq errors)
      (assoc opts :green/exit 2 :green/err (str/join "\n" errors))
      (assoc opts :green/exit 0))))

;; ---------------------------------------------------------------------------
;; JSON configuration and inline scaffolding

(defn- json-text
  [x]
  (str (json/generate-string x {:pretty true}) "\n"))

(defn- failed?
  [opts]
  (pos? (:green/exit opts 0)))

(defn- prune-empty!
  [^java.io.File file]
  (loop [dir (.getParentFile file)]
    (when (and dir (.isDirectory dir) (empty? (.list dir)))
      (when (.delete dir)
        (recur (.getParentFile dir))))))

(defn- scaffold-inline
  [opts specs]
  (let [targets (mapv :target specs)]
    (if (= :delete (:green/event opts))
      (do
        (doseq [target targets
                :let [file (io/file target)]]
          (when (.exists file) (io/delete-file file))
          (prune-empty! file))
        (assoc opts :green/exit 0 :once/deleted targets))
      (do
        (doseq [{:keys [target content]} specs
                :let [file (io/file target)]]
          (io/make-parents file)
          (spit file content))
        (assoc opts :green/exit 0 :once/written targets)))))

(defn- provider-block
  [source version]
  {:source source :version version})

(defn- output-params-block
  [params]
  {:params {:value params}})

(defn- compute-config
  [{:keys [provider-compute compute-pubkey compute-prevent-destroy package]
    :as opts}]
  (case provider-compute
    "digitalocean"
    {:terraform {:required_providers
                 {:digitalocean (provider-block "digitalocean/digitalocean" "~> 2.0")}}
     :provider {:digitalocean {}}
     :resource
     {:digitalocean_ssh_key
      {:green {:name (str package "-green") :public_key compute-pubkey}}
      :digitalocean_droplet
      {:server (cond-> {:name (:digitalocean-name opts)
                        :region (:digitalocean-region opts)
                        :size (:digitalocean-size opts)
                        :image (:digitalocean-image opts)
                        :ssh_keys ["${digitalocean_ssh_key.green.fingerprint}"]
                        :lifecycle {:prevent_destroy (boolean compute-prevent-destroy)}}
                 (not (placeholder? (:digitalocean-vpc-uuid opts)))
                 (assoc :vpc_uuid (:digitalocean-vpc-uuid opts)))}}
     :output (output-params-block
              {:ip "${digitalocean_droplet.server.ipv4_address}"
               :sudoer "root" :uid 0 :name package :user "root"})}

    "hcloud"
    {:terraform {:required_providers
                 {:hcloud (provider-block "hetznercloud/hcloud" "~> 1.45")}}
     :provider {:hcloud {}}
     :resource
     {:hcloud_ssh_key
      {:green {:name (str package "-green") :public_key compute-pubkey}}
      :hcloud_server
      {:server {:name (:hcloud-name opts)
                :image (:hcloud-image opts)
                :server_type (:hcloud-server-type opts)
                :location (:hcloud-location opts)
                :ssh_keys ["${hcloud_ssh_key.green.id}"]
                :public_net [{:ipv4_enabled true :ipv6_enabled false}]
                :lifecycle {:prevent_destroy (boolean compute-prevent-destroy)}}}}
     :output (output-params-block
              {:ip "${hcloud_server.server.ipv4_address}"
               :sudoer "root" :uid 0 :name package :user "root"})}

    "oci"
    {:terraform {:required_providers
                 {:oci (provider-block "oracle/oci" ">= 8.4.0")}}
     :variable {:oci_tenancy_ocid {:type "string" :sensitive true}
                :oci_user_ocid {:type "string" :sensitive true}
                :oci_fingerprint {:type "string" :sensitive true}
                :oci_private_key {:type "string" :sensitive true}}
     :provider {:oci {:region (:oci-region opts)
                      :tenancy_ocid "${var.oci_tenancy_ocid}"
                      :user_ocid "${var.oci_user_ocid}"
                      :fingerprint "${var.oci_fingerprint}"
                      :private_key "${var.oci_private_key}"}}
     :data {:oci_core_subnet
            {:public {:subnet_id (:oci-subnet-id opts)}}
            :oci_core_images
            {:ubuntu {:compartment_id (:oci-compartment-id opts)
                      :operating_system "Canonical Ubuntu"
                      :operating_system_version "24.04"
                      :shape (:oci-shape opts)
                      :sort_by "TIMECREATED"
                      :sort_order "DESC"}}}
     :resource
     {:oci_core_instance
      {:server {:availability_domain (:oci-availability-domain opts)
                :compartment_id (:oci-compartment-id opts)
                :display_name (:oci-display-name opts)
                :shape (:oci-shape opts)
                :shape_config [{:ocpus (:oci-ocpus opts)
                                :memory_in_gbs (:oci-memory-in-gbs opts)}]
                :create_vnic_details [{:subnet_id "${data.oci_core_subnet.public.id}"
                                       :assign_public_ip true}]
                :source_details [{:source_type "image"
                                  :source_id "${data.oci_core_images.ubuntu.images[0].id}"
                                  :boot_volume_size_in_gbs (:oci-boot-volume-size-in-gbs opts)
                                  :boot_volume_vpus_per_gb (:oci-boot-volume-vpus-per-gb opts)}]
                :metadata {:ssh_authorized_keys compute-pubkey}
                :lifecycle {:prevent_destroy (boolean compute-prevent-destroy)}}}}
     :output (output-params-block
              {:ip "${oci_core_instance.server.public_ip}"
               :sudoer "ubuntu" :uid 1001 :name package :user "ubuntu"})}

    "no-infra"
    {:output (output-params-block
              {:ip (:no-infra-compute-ip opts)
               :sudoer (:no-infra-compute-sudoer opts)
               :uid (:no-infra-compute-uid opts)
               :name (or (:no-infra-compute-name opts) package)
               :user (:no-infra-compute-user opts)})}))

(defn- smtp-config
  [{:keys [provider-smtp domain] :as opts}]
  (case provider-smtp
    "resend"
    {:terraform {:required_providers
                 {:resend (provider-block "registry.terraform.io/y0n0zawa/resend" ">= 0.1.0")}}
     :variable {:resend_api_key {:type "string" :sensitive true}}
     :provider {:resend {:api_key "${var.resend_api_key}"}}
     :resource {:resend_domain
                {:domain {:name (str "notifications." domain)
                          :region "eu-west-1"
                          :open_tracking false
                          :click_tracking false
                          :tls "opportunistic"}}}
     :output {:params {:sensitive true
                       :value {:id "${resend_domain.domain.id}"
                               :records "${resend_domain.domain.records}"
                               :smtp_username (:resend-username opts)
                               :smtp_server (:resend-server opts)
                               :smtp_port (:resend-port opts)
                               :smtp_use_starttls true}}}}

    "no-infra"
    {:output (output-params-block
              {:id "no-infra"
               :records []
               :smtp_username (:no-infra-smtp-username opts)
               :smtp_server (:no-infra-smtp-server opts)
               :smtp_port (:no-infra-smtp-port opts)
               :smtp_use_starttls true})}))

(defn- resource-name
  [prefix idx]
  (keyword (str prefix "_" idx)))

(defn- dns-record
  [zone-id {:keys [name type value priority]}]
  (let [priority (cond
                   (number? priority) priority
                   (and (string? priority) (not (str/blank? priority)))
                   (parse-long priority)
                   :else nil)]
    (cond-> {:zone_id zone-id
             :name name
             :type type
             :content (if (= "TXT" type) (str "\"" value "\"") value)
             :proxied false
             :ttl 1}
      (some? priority) (assoc :priority priority))))

(defn- dns-config
  [{:keys [provider-dns domain ip records] :as opts}]
  (case provider-dns
    "cloudflare"
    (let [zone "${data.cloudflare_zone.domain.id}"
          sites (into {}
                      (map-indexed
                       (fn [idx {:keys [host]}]
                         [(resource-name "site" idx)
                          {:zone_id zone :name host :type "A" :content ip
                           :proxied true :ttl 1}])
                       (get-in opts [:once :applications])))
          smtp (into {}
                     (map-indexed
                      (fn [idx record]
                        [(resource-name "smtp" idx) (dns-record zone record)])
                      records))]
      {:terraform {:required_providers
                   {:cloudflare (provider-block "cloudflare/cloudflare" "~> 5.0")}}
       :provider {:cloudflare {}}
       :data {:cloudflare_zone {:domain {:filter {:name domain}}}}
       :resource {:cloudflare_dns_record (merge sites smtp)}})

    "no-infra" {}))

(defn- smtp-post-config
  [{:keys [provider-smtp id]}]
  (case provider-smtp
    "resend"
    {:terraform {:required_providers
                 {:resend (provider-block "registry.terraform.io/y0n0zawa/resend" ">= 0.1.0")}}
     :variable {:resend_api_key {:type "string" :sensitive true}}
     :provider {:resend {:api_key "${var.resend_api_key}"}}
     :resource {:resend_domain_verification
                {:domain {:domain_id id}}}}
    "no-infra" {}))

(defn- main-spec
  [opts tool config]
  (let [dir (tool-dir opts tool)]
    [{:target (str (io/file dir "main.tf.json"))
      :content (json-text config)}]))

(defn- output-params
  [opts]
  (some-> (get-in opts [:tofu/outputs :params]) walk/keywordize-keys))

(defn- tofu-with-spec
  [opts dir specs fallback result-key render-delete?]
  (case (:green/event opts)
    :build (cond-> (scaffold-inline opts specs)
             result-key (assoc result-key fallback))
    :delete (let [prepared (if render-delete?
                             (-> opts
                                 (assoc :green/event :create)
                                 (scaffold-inline specs)
                                 (assoc :green/event :delete))
                             opts)
                  result (tofu/tofu-step prepared {:dir dir})]
              (if (failed? result) result (scaffold-inline result specs)))
    (let [rendered (scaffold-inline opts specs)
          result (tofu/tofu-step rendered {:dir dir})]
      (if (or (failed? result) (nil? result-key))
        result
        (assoc result result-key (merge fallback (or (output-params result) {})))))))

(defn- fallback-compute
  [{:keys [provider-compute package] :as opts}]
  (case provider-compute
    "oci" {:ip "192.0.2.1" :sudoer "ubuntu" :uid 1001
           :name package :user "ubuntu"}
    "no-infra" {:ip (:no-infra-compute-ip opts)
                 :sudoer (:no-infra-compute-sudoer opts)
                 :uid (:no-infra-compute-uid opts)
                 :name (or (:no-infra-compute-name opts) package)
                 :user (:no-infra-compute-user opts)}
    {:ip "192.0.2.1" :sudoer "root" :uid 0 :name package :user "root"}))

(defn- fallback-smtp
  [{:keys [provider-smtp] :as opts}]
  (merge
   {:id "domain-id-not-defined" :records [] :smtp_use_starttls true}
   (if (= provider-smtp "resend")
     {:smtp_username (:resend-username opts)
      :smtp_server (:resend-server opts)
      :smtp_port (:resend-port opts)}
     {:smtp_username (:no-infra-smtp-username opts)
      :smtp_server (:no-infra-smtp-server opts)
      :smtp_port (:no-infra-smtp-port opts)})))

(defn tofu-compute-step
  [opts]
  (let [dir (tool-dir opts "tofu-compute")]
    (tofu-with-spec opts dir (main-spec opts "tofu-compute" (compute-config opts))
                    (fallback-compute opts) :once/compute-params true)))

(defn tofu-smtp-step
  [opts]
  (let [dir (tool-dir opts "tofu-smtp")]
    (tofu-with-spec opts dir (main-spec opts "tofu-smtp" (smtp-config opts))
                    (fallback-smtp opts) :once/smtp-params true)))

(defn- joined-params
  [opts]
  (let [branches (:green/branches opts)
        compute (or (some :once/compute-params branches)
                    (:once/compute-params opts)
                    (fallback-compute opts))
        smtp (or (some :once/smtp-params branches)
                 (:once/smtp-params opts)
                 (fallback-smtp opts))]
    (-> opts
        (merge compute smtp)
        (assoc :once/compute-params compute :once/smtp-params smtp))))

(defn tofu-dns-step
  [opts]
  (let [opts (if (= :delete (:green/event opts)) opts (joined-params opts))
        dir (tool-dir opts "tofu-dns")]
    (tofu-with-spec opts dir (main-spec opts "tofu-dns" (dns-config opts)) {} nil
                    (or (= "no-infra" (:provider-dns opts))
                        (and (:once/existing-compute? opts)
                             (:once/existing-smtp? opts))))))

(defn tofu-smtp-post-step
  [opts]
  (let [dir (tool-dir opts "tofu-smtp-post")]
    (tofu-with-spec opts dir (main-spec opts "tofu-smtp-post" (smtp-post-config opts)) {} nil
                    (or (= "no-infra" (:provider-smtp opts))
                        (:once/existing-smtp? opts)))))

;; ---------------------------------------------------------------------------
;; Ansible configuration

(def ^:private ansible-config
  (str "[defaults]\n"
       "interpreter_python = auto_silent\n"
       "inventory = inventory.json\n"
       "host_key_checking = False\n"
       "gathering = explicit\n\n"
       "[ssh_connection]\n"
       "ssh_args = -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ForwardAgent=yes\n"
       "pipelining = True\n"))

(def ^:private deploy-script
  "#!/usr/local/bin/bb\n\n(require '[babashka.process :as p]\n         '[clojure.string :as str])\n\n(defn die [msg]\n  (binding [*out* *err*]\n    (println (str \"deploy: \" msg)))\n  (System/exit 1))\n\n(def host-pattern #\"^[A-Za-z0-9]([A-Za-z0-9.-]{0,253}[A-Za-z0-9])?$\")\n\n(defn strip-ansi [s]\n  (-> s\n      (str/replace #\"\\x1b\\]8;[^\\x07]*\\x07\" \"\")\n      (str/replace #\"\\x1b\\[[0-9;]*m\" \"\")))\n\n(defn parse-allowed-hosts []\n  (let [{:keys [exit out err]} @(p/process [\"sudo\" \"once\" \"list\"]\n                                           {:out :string :err :string})]\n    (when-not (zero? exit)\n      (die (str \"could not list applications: \" (str/trim err))))\n    (->> (str/split-lines (strip-ansi out))\n         (keep #(re-find #\"[\\w][\\w.-]+\\.[\\w]{2,}(?= \\()\" %))\n         set)))\n\n(defn -main [& _]\n  (let [original (System/getenv \"SSH_ORIGINAL_COMMAND\")]\n    (when (str/blank? original)\n      (die \"interactive sessions are not allowed\"))\n    (let [tokens (str/split (str/trim original) #\"\\s+\")]\n      (when-not (= 4 (count tokens))\n        (die (str \"command not allowed: \" original)))\n      (let [[a b c host] tokens]\n        (when-not (and (= a \"sudo\") (= b \"once\") (= c \"update\"))\n          (die (str \"command not allowed: \" original)))\n        (when-not (re-matches host-pattern host)\n          (die (str \"invalid host: \" host)))\n        (let [allowed (parse-allowed-hosts)]\n          (when-not (contains? allowed host)\n            (die (str \"host not allowed: \" host))))\n        (let [{:keys [exit]} @(p/process [\"sudo\" \"once\" \"update\" host]\n                                         {:out :inherit :err :inherit})]\n          (System/exit exit))))))\n\n(when (= *file* (System/getProperty \"babashka.file\"))\n  (apply -main *command-line-args*))\n")

(def ^:private once-module
  "#!/usr/local/bin/bb\n;; WANT_JSON\n\n(require '[cheshire.core :as json]\n         '[babashka.process :as p]\n         '[clojure.string :as str]\n         '[clojure.set :as set])\n\n(defn exit-json [result]\n  (println (json/generate-string result))\n  (System/exit (if (:failed result) 1 0)))\n\n(defn fail-json\n  ([msg] (fail-json msg {}))\n  ([msg extra] (exit-json (merge {:failed true :changed false :msg msg} extra))))\n\n(defn run! [cmd]\n  (let [result @(p/process cmd {:out :string :err :string})]\n    (when-not (zero? (:exit result))\n      (fail-json (str/trim (:err result)) {:rc (:exit result) :cmd cmd}))\n    result))\n\n(defn strip-ansi [s]\n  (-> s\n      (str/replace #\"\\x1b\\]8;[^\\x07]*\\x07\" \"\")\n      (str/replace #\"\\x1b\\[[0-9;]*m\" \"\")))\n\n(defn parse-deployed-hosts [output]\n  (->> (str/split-lines output)\n       (keep #(re-find #\"[\\w][\\w.-]+\\.[\\w]{2,}(?= \\()\" %))\n       set))\n\n(defn build-deploy-cmd [namespace app]\n  (cond-> [\"once\" \"-n\" namespace \"deploy\" (:image app) \"--host\" (:host app)]\n    (:smtp_server app)   (into [\"--smtp-server\" (:smtp_server app)])\n    (:smtp_port app)     (into [\"--smtp-port\" (str (:smtp_port app))])\n    (:smtp_username app) (into [\"--smtp-username\" (:smtp_username app)])\n    (:smtp_password app) (into [\"--smtp-password\" (:smtp_password app)])\n    (:smtp_from app)     (into [\"--smtp-from\" (:smtp_from app)])\n    (:auto_update app)   (conj \"--auto-update\")\n    (:auto_backup app)   (conj \"--auto-backup\")\n    (:backup_path app)   (into [\"--backup-path\" (:backup_path app)])\n    (:disable_tls app)   (conj \"--disable-tls\")\n    (:cpus app)          (into [\"--cpus\" (str (:cpus app))])\n    (:memory app)        (into [\"--memory\" (str (:memory app))])\n    (seq (:env app))     (into (mapcat #(vector \"--env\" %) (:env app)))))\n\n(defn build-remove-cmd [namespace host remove-data?]\n  (cond-> [\"once\" \"-n\" namespace \"remove\" host]\n    remove-data? (conj \"--remove-data\")))\n\n(defn reconcile [applications namespace remove-data? teardown?]\n  (when-not (seq applications)\n    (fail-json \"Missing required parameter: applications\"))\n  (when teardown?\n    (run! (cond-> [\"once\" \"-n\" namespace \"teardown\"]\n            remove-data? (conj \"--remove-data\"))))\n  (let [apps-by-host (into {} (map (juxt :host identity)) applications)\n        desired-hosts (set (keys apps-by-host))\n        list-out (strip-ansi (:out (run! [\"once\" \"-n\" namespace \"list\"])))\n        deployed (parse-deployed-hosts list-out)\n        to-deploy (set/difference desired-hosts deployed)\n        to-remove (set/difference deployed desired-hosts)]\n    (doseq [host to-remove]\n      (run! (build-remove-cmd namespace host remove-data?)))\n    (doseq [host to-deploy]\n      (run! (build-deploy-cmd namespace (apps-by-host host))))\n    (exit-json {:changed (boolean (or (seq to-deploy) (seq to-remove)))\n                :deployed (vec to-deploy) :removed (vec to-remove)})))\n\n(defn -main [& args]\n  (when-not (first args) (fail-json \"No args file provided by Ansible\"))\n  (let [params (json/parse-string (slurp (first args)) true)]\n    (reconcile (:applications params)\n               (or (:namespace params) \"once\")\n               (boolean (:remove_data params))\n               (boolean (:teardown params)))))\n\n(when (= *file* (System/getProperty \"babashka.file\"))\n  (apply -main *command-line-args*))\n")

(defn- inventory-data
  [{:keys [name ip sudoer]}]
  {:all {:hosts {(or name "once")
                 {:ansible_host ip :ansible_user (or sudoer "root")}}}})

(defn- application-data
  [opts app]
  (let [env (mapv (fn [[container-name host-env]]
                    (str (name container-name) "={{ lookup('env', '" host-env "') }}"))
                  (:env app))]
    (cond-> (-> app
                (dissoc :env)
                (assoc :smtp_server (:smtp_server opts)
                       :smtp_port (:smtp_port opts)
                       :smtp_username (:smtp_username opts)
                       :smtp_password "{{ lookup('env', 'ONCE_SMTP_PASSWORD') }}"
                       :smtp_from (str "Info <info@notifications." (:domain opts) ">")))
      (seq env) (assoc :env env))))

(defn- once-tasks
  [opts]
  [{:name "Reconcile ONCE applications"
    :become true
    :once {:namespace "once"
           :applications (mapv #(application-data opts %)
                               (get-in opts [:once :applications]))}}])

(defn- main-playbook
  [opts]
  [{:name "Configure the ONCE server"
    :hosts "all"
    :become true
    :tasks
    [{:name "Install Docker"
      "ansible.builtin.shell" "curl -fsSL https://get.docker.com -o /tmp/install-docker.sh && sh /tmp/install-docker.sh && rm /tmp/install-docker.sh"
      :args {:creates "/usr/bin/docker"}
      :register "docker_install"
      :until "docker_install.rc == 0"
      :retries 10 :delay 10}
     {:name "Install ONCE"
      "ansible.builtin.shell" "curl -fsSL https://get.once.com -o /tmp/install-once.sh && ONCE_INTERACTIVE=false sh /tmp/install-once.sh && rm /tmp/install-once.sh"
      :args {:creates "/usr/local/bin/once"}
      :register "once_install"
      :until "once_install.rc == 0"
      :retries 10 :delay 10}
     {:name "Install s-nail"
      "ansible.builtin.apt" {:name "s-nail" :state "present"
                              :update_cache true :cache_valid_time 3600}}
     {:name "Configure outgoing mail"
      "ansible.builtin.template" {:src "mailrc.j2" :dest "/root/.mailrc"
                                   :owner "root" :group "root" :mode "0600"}}
     {:name "Install Babashka"
      "ansible.builtin.shell" "curl -sLO https://raw.githubusercontent.com/babashka/babashka/master/install && chmod +x install && ./install && rm install"
      :args {:creates "/usr/local/bin/bb"}
      :register "bb_install"
      :until "bb_install.rc == 0"
      :retries 10 :delay 10}
     {:name "Create deploy user"
      "ansible.builtin.user" {:name "deploy" :shell "/bin/bash"
                               :create_home true :state "present"}}
     {:name "Grant deploy access to ONCE"
      "ansible.builtin.copy" {:dest "/etc/sudoers.d/deploy"
                               :content "deploy ALL=(ALL) NOPASSWD: /usr/local/bin/once *\n"
                               :owner "root" :group "root" :mode "0440"
                               :validate "/usr/sbin/visudo -cf %s"}}
     {:name "Install restricted deploy command"
      "ansible.builtin.copy" {:src "files/deploy" :dest "/usr/local/bin/deploy"
                               :owner "root" :group "root" :mode "0755"}}
     {:name "Create deploy SSH directory"
      "ansible.builtin.file" {:path "/home/deploy/.ssh" :state "directory"
                               :owner "deploy" :group "deploy" :mode "0700"}}
     {:name "Authorize deploy key with ForceCommand"
      "ansible.builtin.copy" {:dest "/home/deploy/.ssh/authorized_keys"
                               :content (str "restrict,command=\"/usr/local/bin/deploy\" "
                                             (:deploy-pubkey opts) "\n")
                               :owner "deploy" :group "deploy" :mode "0600"}}
     {:name "Reconcile ONCE applications"
      "ansible.builtin.import_tasks" "once.json"}]}])

(defn- mailrc-template
  [opts]
  (str "set v15-compat=yes\n"
       "set mta=smtp://" (:smtp_username opts)
       ":{{ lookup('env', 'ONCE_SMTP_PASSWORD') }}@"
       (:smtp_server opts) ":" (:smtp_port opts) "\n"
       "set smtp-auth=login\n"
       "set smtp-use-starttls\n"
       "set from=\"Info <info@notifications." (:domain opts) ">\"\n"
       "set hostname=" (:domain opts) "\n"))

(defn- ansible-local-specs
  [opts]
  (let [{:keys [name ip sudoer]} (or (:once/compute-params opts)
                                     (fallback-compute opts))
        dir (tool-dir opts "ansible-local")]
    [{:target (str (io/file dir "config"))
      :content (str "# managed by Green; include this fragment from ~/.ssh/config\n"
                    "Host " name "\n"
                    "  HostName " ip "\n"
                    "  User " sudoer "\n"
                    "  ForwardAgent yes\n")}]))

(defn- ansible-remote-specs
  [opts]
  (let [dir (tool-dir opts "ansible-remote")]
    [{:target (str (io/file dir "ansible.cfg")) :content ansible-config}
     {:target (str (io/file dir "inventory.json"))
      :content (json-text (inventory-data (:once/compute-params opts)))}
     {:target (str (io/file dir "main.json"))
      :content (json-text (main-playbook opts))}
     {:target (str (io/file dir "once.json"))
      :content (json-text (once-tasks opts))}
     {:target (str (io/file dir "mailrc.j2")) :content (mailrc-template opts)}
     {:target (str (io/file dir "files" "deploy")) :content deploy-script}
     {:target (str (io/file dir "library" "once")) :content once-module}]))

(defn ansible-local-step
  [opts]
  (scaffold-inline opts (ansible-local-specs opts)))

(defn ansible-remote-step
  [opts]
  (let [dir (tool-dir opts "ansible-remote")
        rendered (scaffold-inline opts (ansible-remote-specs opts))]
    (if (= :build (:green/event opts))
      rendered
      (ansible/ansible-step rendered {:dir dir
                                      :inventory "inventory.json"
                                      :playbooks {:create "main.json"}
                                      :host-key-checking false}))))

(defn ansible-cleanup-step
  [opts]
  (let [opts (assoc opts :green/event :delete)
        local (scaffold-inline opts (ansible-local-specs opts))]
    (scaffold-inline local (ansible-remote-specs opts))))

;; ---------------------------------------------------------------------------
;; Workflow and backend advice

(def tofu-steps
  [:once/tofu-compute :once/tofu-smtp :once/tofu-dns :once/tofu-smtp-post])

(def side-effecting-steps
  (into tofu-steps [:once/ansible-local :once/ansible-remote
                    :once/ansible-cleanup]))

(defn wire-fn
  [step run-opts]
  (if (= :delete (:green/event run-opts))
    (case step
      :once/start           [start-step :once/ansible-cleanup]
      :once/ansible-cleanup [ansible-cleanup-step :once/tofu-smtp-post]
      :once/tofu-smtp-post  [tofu-smtp-post-step :once/tofu-dns]
      :once/tofu-dns        [tofu-dns-step :once/tofu-smtp :once/tofu-compute]
      :once/tofu-smtp       [tofu-smtp-step]
      :once/tofu-compute    [tofu-compute-step])
    (case step
      :once/start          [start-step :once/tofu-compute :once/tofu-smtp]
      :once/tofu-compute   [tofu-compute-step :once/tofu-dns]
      :once/tofu-smtp      [tofu-smtp-step :once/tofu-dns]
      :once/tofu-dns       [tofu-dns-step :once/tofu-smtp-post]
      :once/tofu-smtp-post [tofu-smtp-post-step :once/ansible-local :once/ansible-remote]
      :once/ansible-local  [ansible-local-step]
      :once/ansible-remote [ansible-remote-step])))

(defn- r2-backend-advice
  [dir-fn tool]
  (tofu/s3-backend-advice
   dir-fn
   (fn [opts]
     {:bucket (:r2-bucket opts)
      :key (str (:profile opts) "/" tool ".tfstate")
      :region "auto"
      :endpoints {:s3 (:r2-endpoint opts)}
      :skip_credentials_validation true
      :skip_metadata_api_check true
      :skip_region_validation true
      :skip_requesting_account_id true
      :use_path_style false})))

(defn- backend-advice
  [tool]
  (let [dir-fn #(tool-dir % tool)]
    (fn [opts]
      (case (:provider-backend opts)
        "local" ((tofu/local-backend-advice dir-fn) opts)
        "s3" ((tofu/s3-backend-advice
                dir-fn
                {:bucket (:s3-bucket opts)
                 :key (str (:profile opts) "/" tool ".tfstate")
                 :region (:s3-region opts)})
              opts)
        "r2" ((r2-backend-advice dir-fn tool) opts)
        (throw (ex-info "unsupported OpenTofu backend"
                        {:provider-backend (:provider-backend opts)}))))))

(def workflow
  (-> (wf/workflow {:start :once/start :wire-fn wire-fn})
      (wf/advice-add :once/tofu-compute :before ::backend
                     (backend-advice "tofu-compute"))
      (wf/advice-add :once/tofu-smtp :before ::backend
                     (backend-advice "tofu-smtp"))
      (wf/advice-add :once/tofu-dns :before ::backend
                     (backend-advice "tofu-dns"))
      (wf/advice-add :once/tofu-smtp-post :before ::backend
                     (backend-advice "tofu-smtp-post"))
      progress/advise
      (dry-run/advise side-effecting-steps)))

;; ---------------------------------------------------------------------------
;; Describe and CLI

(defn- command
  [& args]
  (try
    (apply sh/sh args)
    (catch Exception e
      {:exit -1 :out "" :err (or (ex-message e) (str (class e)))})))

(defn- describe-state
  [opts]
  (let [opts (read-green-pars opts)
        compute (or (state-output opts "tofu-compute") (fallback-compute opts))
        smtp (or (state-output opts "tofu-smtp") (fallback-smtp opts))
        target (str (:sudoer compute) "@" (:ip compute))
        ssh-args ["ssh" "-o" "BatchMode=yes" "-o" "ConnectTimeout=5"
                  "-o" "StrictHostKeyChecking=accept-new" target]
        probe (apply command (concat ssh-args ["true"]))
        running? (zero? (:exit probe))
        apps (when running?
               (apply command (concat ssh-args ["sudo" "-n" "once" "list"])))]
    {:profile (:profile opts)
     :providers {:compute (:provider-compute opts)
                 :smtp (:provider-smtp opts)
                 :dns (:provider-dns opts)
                 :backend (:provider-backend opts)}
     :compute (assoc compute
                     :running? running?
                     :detail (if running?
                               "ssh ok"
                               (or (not-empty (str/trim (:err probe)))
                                   "ssh failed")))
     :smtp (select-keys smtp [:smtp_server :smtp_port :smtp_username])
     :applications (when (and apps (zero? (:exit apps))) (:out apps))
     :applications-error (when (and apps (pos? (:exit apps)))
                           (or (not-empty (str/trim (:err apps)))
                               "once list failed"))}))

(defn- print-description
  [{:keys [profile providers compute applications applications-error]}]
  (println "Profile:" profile)
  (println "Providers:")
  (doseq [k [:compute :smtp :dns :backend]]
    (println (format "  %-8s %s" (str (name k) ":") (get providers k))))
  (println "Compute:")
  (println "  IP:" (:ip compute))
  (println "  SSH user:" (:sudoer compute))
  (println "  Status:" (if (:running? compute) "running" "not reachable")
           (str "(" (:detail compute) ")"))
  (cond
    applications-error (println "Applications unavailable:" applications-error)
    (str/blank? applications) (println "Applications: none found")
    :else (do (println "Applications:") (print applications))))

(def ^:private describe-spec
  {:file {:alias :f :default "green.edn"}})

(defn- run-describe
  [args]
  (try
    (let [{:keys [opts]} (bb-cli/parse-args (vec (rest args))
                                            {:spec describe-spec})
          file (io/file (:file opts))]
      (if-not (.exists file)
        {:green/exit 2 :green/err (str "desired state file not found: " file)}
        (let [description (describe-state (edn/read-string (slurp file)))]
          (print-description description)
          {:green/exit 0 :once/description description})))
    (catch Throwable t
      {:green/exit 2 :green/err (or (ex-message t) (str (class t)))})))

(def usage
  "Usage: ./green <build|create|delete|describe> [-f|--file green.edn] [--dry-run]")

(defn run
  "REPL-friendly entry point returning Green's Unix-style outcome map."
  [& args]
  (let [args (vec args)
        event (first args)]
    (cond
      (= "describe" event) (run-describe args)
      (contains? #{"build" "create" "delete"} event) (green-cli/run-cli workflow args)
      (contains? #{"help" "--help" "-h"} event) {:green/exit 0 :green/err usage}
      :else {:green/exit 2 :green/err usage})))

(defn -main
  [& args]
  (let [{:green/keys [exit err trace]} (apply run args)]
    (when err
      (binding [*out* (if (zero? (or exit 0)) *out* *err*)]
        (println err)
        (when trace (println trace))))
    (System/exit (or exit 0))))

(defn- launched-as-script?
  []
  (when-let [bb-file (System/getProperty "babashka.file")]
    (= (str (fs/canonicalize bb-file))
       (str (fs/canonicalize *file*)))))

(when (launched-as-script?)
  (apply -main *command-line-args*))
